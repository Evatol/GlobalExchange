# Plantilla de variables de entorno. Copiar a .env y ajustar por entorno.
# El .env real NO se sube a git. Si una variable falta, settings.py usa
# el valor por defecto de desarrollo.

# --- Seguridad / entorno ---
# En producción: DEBUG=False, un SECRET_KEY largo y aleatorio propio, y
# ALLOWED_HOSTS con los dominios/IP reales separados por coma.
SECRET_KEY=django-insecure-clave-ejemplo-cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos (PostgreSQL) ---
DB_NAME=Global_Exchange
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# --- Keycloak: cliente OIDC y API admin (config/settings.py) ---
# En producción (u otro realm que no sea el de desarrollo del equipo), sobrescribir
# con los valores reales. Si faltan, se usan los defaults del realm local de dev
# (mismos que ya estaban hardcodeados) para no romper el entorno de nadie.
# OIDC_RP_CLIENT_ID=django-backend
# OIDC_RP_CLIENT_SECRET=          # Secreto del cliente OIDC "django-backend" en Keycloak. NO commitear el .env real.
#
# KEYCLOAK_SERVER_URL: la usa Django puertas adentro (intercambio de tokens,
# JWKS, API admin). KEYCLOAK_PUBLIC_URL: a la que se redirige el NAVEGADOR
# (login, logout, Account Console). Corriendo todo en la máquina local son
# la misma URL; en Docker Compose no (ver docker-compose.yml): ahí
# KEYCLOAK_SERVER_URL pasa a ser "http://keycloak:8080/" (nombre del
# servicio) mientras KEYCLOAK_PUBLIC_URL sigue en "http://localhost:8080/"
# (el puerto publicado), porque el navegador no resuelve nombres internos
# de la red de Docker.
# KEYCLOAK_SERVER_URL=http://localhost:8080/
# KEYCLOAK_PUBLIC_URL=http://localhost:8080/
# KEYCLOAK_REALM=GlobalExchange
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=        # Password del admin de Keycloak. NO commitear el .env real.

# --- Keycloak: SMTP del realm (comando: manage.py configure_keycloak_registration) ---
# App Password de Gmail (16 caracteres) para que Keycloak envie los correos de
# verificacion del autoregistro. La app Django NO lo lee: lo usa solo ese
# comando de configuracion.
#
# NO se hardcodea en el repo (es publico): cada integrante lo pega en SU .env,
# que git ignora. Con eso, levantar todo con verificacion por correo es:
#
#     ./scripts/levantar_sistema.sh --con-correo
#
# Sin esta variable el sistema levanta igual, solo que sin verificacion.
# KEYCLOAK_SMTP_PASSWORD=

# --- Correo saliente de Django (alta de usuario por admin, RF3) ---
# En desarrollo el default imprime el correo en la terminal. Para envio real:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=globalexchange314@gmail.com
# EMAIL_HOST_PASSWORD=   # App Password de Gmail (16 chars). NO commitear el .env real.

# --- Pasarela de pago externa: webhook (E4-157/E4-158) ---
# Secreto compartido con la pasarela. El webhook (/api/transacciones/webhook/pago/)
# solo acepta avisos firmados con HMAC-SHA256 con este secreto en el encabezado
# X-Signature. Sin secreto, rechaza todo. En desarrollo (DEBUG=True) hay uno por
# defecto; en produccion hay que definirlo con un valor largo y aleatorio.
# WEBHOOK_PAGO_SECRET=

# --- Stripe: pasarela de pago de las compras que no son en efectivo ---
# Claves de PRUEBA (Dashboard de Stripe, en "Entorno de prueba" -> Desarrolladores ->
# Claves de API). NO commitear el .env real: en un repo publico, Stripe revoca una
# clave secreta que detecta expuesta. Con STRIPE_SECRET_KEY el sistema cobra esas
# compras con Stripe (en guaranies, en la pagina de Stripe); sin ella sigue con la
# pasarela simulada. Para pagar en pruebas: tarjeta 4242 4242 4242 4242, cualquier
# fecha futura y cualquier CVC.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Secreto del webhook (opcional). Sin el, la operacion igual se confirma cuando el
# cliente vuelve de Stripe; con el, tambien si cierra la pestana antes de volver. En
# desarrollo sale de:  stripe listen --forward-to localhost:8000/api/pasarela/stripe/webhook/
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Fuerza la pasarela: "stripe" o "simulada" (por defecto "stripe" si hay clave secreta).
# PASARELA_PROVEEDOR=simulada

# --- Facturación electrónica (apps.facturacion, ver docs/facturacion.md) ---
# Proveedor al que se envían las facturas: "simulado" (por defecto, aprueba al instante y
# no tiene validez tributaria) o "facturasegura" (API de Factura Segura / SIFEN).
# FACTURACION_PROVEEDOR=simulado
# Al emitirse, la factura se manda por correo (PDF adjunto) al usuario que hizo la operación.
# FACTURACION_ENVIAR_CORREO=true
# Para mostrar el reintento: con false el simulador responde como si estuviera caído.
# Después, "manage.py procesar_facturas" envía las pendientes.
# FACTURACION_SIMULADOR_DISPONIBLE=true
#
# Solo con facturasegura: token del usuario ESI (NO commitear el .env real).
# FACTURA_SEGURA_TOKEN=
# FACTURA_SEGURA_URL=https://apitest.facturasegura.com.py/misife00/v1/esi
#
# Timbrado y numeración del emisor, y sus datos (los valores por defecto son de DEMO).
# FACTURACION_TIMBRADO=12345678
# FACTURACION_TIMBRADO_INICIO=2026-01-01
# FACTURACION_ESTABLECIMIENTO=001
# FACTURACION_PUNTO_EXPEDICION=001
# FACTURACION_EMISOR_RUC=80000000
# FACTURACION_EMISOR_DV=0
# FACTURACION_EMISOR_NOMBRE=GLOBAL EXCHANGE S.A. (DEMO)
# FACTURACION_EMISOR_DIRECCION=AVENIDA MARISCAL LOPEZ
# FACTURACION_EMISOR_NUMERO_CASA=0
# FACTURACION_EMISOR_TELEFONO=(021)000000
# FACTURACION_EMISOR_EMAIL=globalexchange314@gmail.com
# (también: _DEPARTAMENTO_CODIGO, _DEPARTAMENTO, _CIUDAD_CODIGO, _CIUDAD, _ACTIVIDAD_CODIGO
#  y _ACTIVIDAD, con el prefijo FACTURACION_EMISOR)

# --- Pasarela de pago simulada (apps.pasarela) ---
# Pantalla que hace de empresa de pagos para probar el pago externo sin un proveedor
# real: el cliente "paga" o "rechaza" y la pasarela avisa al sistema por el webhook.
# Deja pagar sin pagar, asi que NUNCA debe estar en true donde se cobre de verdad. Si
# no se define, queda encendida solo con DEBUG=True.
# PASARELA_SIMULADA_ACTIVA=true

# --- Cierre de sesión por inactividad (E4-195, apps.usuarios.inactividad) ---
# Aplica a todos los roles: tras INACTIVIDAD_SEGUNDOS sin actividad se cierra la sesión
# (con un aviso de INACTIVIDAD_AVISO_SEGUNDOS antes). Para una demostración larga se
# puede alargar o apagar.
# INACTIVIDAD_ACTIVA=true
# INACTIVIDAD_SEGUNDOS=300
# INACTIVIDAD_AVISO_SEGUNDOS=30
