# Plantilla de variables de entorno. Copiar a .env y ajustar por entorno.
# El .env real NO se sube a git. Si una variable falta, settings.py usa
# el valor por defecto de desarrollo.

# --- Seguridad / entorno ---
# En producción: DEBUG=False, un SECRET_KEY largo y aleatorio propio, y
# ALLOWED_HOSTS con los dominios/IP reales separados por coma.
SECRET_KEY=django-insecure-clave-ejemplo-cambiar-en-produccion
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos (PostgreSQL) ---
DB_NAME=Global_Exchange
DB_USER=postgres
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=5432

# --- Keycloak: cliente OIDC y API admin (config/settings.py) ---
# En producción (u otro realm que no sea el de desarrollo del equipo), sobrescribir
# con los valores reales. Si faltan, se usan los defaults del realm local de dev
# (mismos que ya estaban hardcodeados) para no romper el entorno de nadie.
# OIDC_RP_CLIENT_ID=django-backend
# OIDC_RP_CLIENT_SECRET=          # Secreto del cliente OIDC "django-backend" en Keycloak. NO commitear el .env real.
#
# KEYCLOAK_SERVER_URL: la usa Django puertas adentro (intercambio de tokens,
# JWKS, API admin). KEYCLOAK_PUBLIC_URL: a la que se redirige el NAVEGADOR
# (login, logout, Account Console). Corriendo todo en la máquina local son
# la misma URL; en Docker Compose no (ver docker-compose.yml): ahí
# KEYCLOAK_SERVER_URL pasa a ser "http://keycloak:8080/" (nombre del
# servicio) mientras KEYCLOAK_PUBLIC_URL sigue en "http://localhost:8080/"
# (el puerto publicado), porque el navegador no resuelve nombres internos
# de la red de Docker.
# KEYCLOAK_SERVER_URL=http://localhost:8080/
# KEYCLOAK_PUBLIC_URL=http://localhost:8080/
# KEYCLOAK_REALM=GlobalExchange
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=        # Password del admin de Keycloak. NO commitear el .env real.

# --- Keycloak: SMTP del realm (comando: manage.py configure_keycloak_registration) ---
# App Password de Gmail (16 caracteres) para que Keycloak envie los correos de
# verificacion del autoregistro. Se usa SOLO al correr ese comando de configuracion;
# la app Django NO lo lee. NO subir el .env real con este valor.
# KEYCLOAK_SMTP_PASSWORD=

# --- Correo saliente de Django (alta de usuario por admin, RF3) ---
# En desarrollo el default imprime el correo en la terminal. Para envio real:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=globalexchange314@gmail.com
# EMAIL_HOST_PASSWORD=   # App Password de Gmail (16 chars). NO commitear el .env real.
